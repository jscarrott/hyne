# Hyne - devices with at least one analog stick
# Left stick moves the pointer, the d-pad walks through the controls.

left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
mouse_scale = 8192
mouse_delay = 16
deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8

up = up
down = down
left = left
right = right

a = mouse_left
b = esc
x = enter
y = tab

# Previous / next editor page
l1 = pageup
l1 = add_ctrl
r1 = pagedown
r1 = add_ctrl

# Scroll inside a page
l2 = pageup
r2 = pagedown

# Opens the menu bar
start = f10

# Slower pointer for small check boxes
l3 = mouse_slow
mouse_slow_scale = 40
