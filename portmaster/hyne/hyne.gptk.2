# Hyne - devices with two analog sticks
#
# The d-pad drives the interface: up and down walk through the controls,
# left and right change the value of the focused one. The left stick moves
# a pointer, the right one scrolls.

up = up
down = down
left = left
right = right

a = space
b = esc
x = enter
y = tab

# Previous / next editor page
l1 = pageup
l1 = add_ctrl
r1 = pagedown
r1 = add_ctrl

# Scroll a page, jump through the memory card
l2 = pageup
r2 = pagedown

# Opens the menu bar
start = f10

# Pointer on the stick, click with the stick button
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
mouse_scale = 8192
mouse_delay = 16
deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
l3 = mouse_left
r3 = mouse_left

right_analog_up = pageup
right_analog_down = pagedown
