# Hyne - devices without an analog stick
#
# The d-pad drives the interface: up and down walk through the controls,
# left and right change the value of the focused one. There is no pointer
# on these devices, every control is reachable this way.

up = up
down = down
left = left
right = right

a = space
b = esc
x = enter
y = tab

# Previous / next editor page
l1 = pageup
l1 = add_ctrl
r1 = pagedown
r1 = add_ctrl

# Scroll a page, jump through the memory card
l2 = pageup
r2 = pagedown

# Opens the menu bar
start = f10
