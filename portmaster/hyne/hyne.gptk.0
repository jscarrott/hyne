# Hyne - devices without an analog stick
# The d-pad moves the pointer, L3 is not available so the pointer speed is
# lowered with L2 instead.

up = mouse_movement_up
down = mouse_movement_down
left = mouse_movement_left
right = mouse_movement_right
dpad_mouse_step = 7
mouse_scale = 8192
mouse_delay = 16

a = mouse_left
b = esc
x = enter
y = tab

# Previous / next editor page
l1 = pageup
l1 = add_ctrl
r1 = pagedown
r1 = add_ctrl

# Scroll inside a page
r2 = pagedown

# Opens the menu bar
start = f10

# Slower pointer for small check boxes
l2 = mouse_slow
mouse_slow_scale = 40
